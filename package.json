{
  "name": "career-os",
  "private": false,
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "description": "Open-source local-first job hunt automation for tech professionals",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js --all",
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && tsx scripts/local-server.js",
    "start:server": "tsx scripts/local-server.js",
    "lint": "eslint src scripts",
    "test": "vitest run && .venv/bin/python -m pytest tests/python -q",
    "test:js": "vitest run",
    "test:python": ".venv/bin/python -m pytest tests/python -q",
    "preview": "vite preview",
    "generate-roles": "node scripts/generate-roles.js",
    "regenerate-intelligence": "node scripts/regenerate-intelligence.js",
    "setup:jobspy": "node scripts/setup.js --jobspy",
    "setup:jobs": "node scripts/setup.js --jobs",
    "discover:jobs": "node scripts/run-discovery.js --providers ats --country USA",
    "discover:jobs:mock": "node scripts/run-discovery.js --mock",
    "score:jobs": ".venv/bin/python python/job_scoring/run_scoring.py",
    "tailor:resumes": ".venv/bin/python python/resume_generator/run_tailor.py",
    "scan:projects": "node scripts/run-project-scan.js",
    "import:job": "node scripts/run-job-import.js",
    "claude:login": "node scripts/claude-auth.js",
    "audit:quality": "bash -c 'source .venv/bin/activate && python python/quality_audit/run_audit.py \"$@\"' --",
    "validate:companies": "node scripts/validate-companies.js"
  },
  "dependencies": {
    "@sparring/tech-roles-library": "^1.1.1",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "vitest": "^3.2.6"
  }
}
